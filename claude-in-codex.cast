[0.009, "o", "\u001b[23;2H\u001b[0m\u001b[49m\u001b[K\u001b[24;2H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[25;26H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[26;79H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[27;2H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[28;59H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[29;56H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[30;79H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[31;89H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[32;49H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[33;82H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[34;81H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[35;2H\u001b[0m\u001b[48;2;30;30;30m\u001b[K\u001b[24;1H \u001b[25;1H  \u001b[1mSelect Model and Effort\u001b[26;1H\u001b[22m  \u001b[2mAccess legacy models by running codex -m <model_name> or in your config.toml\u001b[27;1H\u001b[22m \u001b[28;1H\u001b[1m\u001b[38;5;6;48;2;30;30;30m› 1. gpt-5.4 (default)   Strong model for everyday coding.\u001b[29;1H\u001b[22m\u001b[39;48;2;30;30;30m  2. gpt-5.2-codex       \u001b[2mFrontier agentic coding model.\u001b[30;1H\u001b[22m  3. gpt-5.1-codex-max   \u001b[2mCodex-optimized flagship for deep and fast reasoning.\u001b[31;1H\u001b[22m  4. gpt-5.4-mini        \u001b[2mSmall, fast, and cost-efficient model for simpler coding tasks.\u001b[32;1H\u001b[22m  5. gpt-5.3-codex       \u001b[2mCoding-optimized model.\u001b[33;1H\u001b[22m  6. gpt-5.2             \u001b["]
[0.000, "o", "2mOptimized for professional work and long-running agents.\u001b[34;1H\u001b[22m  7. gpt-5.1-codex-mini  \u001b[2mOptimized for codex. Cheaper, faster, but less capable.\u001b[35;1H\u001b[22m \u001b[36;3H\u001b[2m\u001b[39;49mPress enter to select reasoning effort, or esc to dismiss.                                                                                                                                \u001b[39m\u001b[49m\u001b[0m\u001b[?25l"]
